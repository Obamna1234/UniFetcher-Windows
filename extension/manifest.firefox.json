{
  "manifest_version": 3,
  "name": "Send to UniFetcher",
  "short_name": "UniFetcher",
  "version": "0.0.0",
  "description": "Send pages, links, detected videos or all your tabs to the UniFetcher app on this PC. Collects nothing; talks only to UniFetcher.",
  "browser_specific_settings": {
    "gecko": {
      "id": "unifetcher-extension@obamna1234.github.io",
      "strict_min_version": "128.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "permissions": ["nativeMessaging", "contextMenus", "tabs", "webRequest", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "scripts": ["background.js"] },
  "action": {
    "default_title": "Send to UniFetcher",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "38": "icons/icon38.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "commands": {
    "send-page": {
      "suggested_key": { "default": "Alt+Shift+U" },
      "description": "Send this page to UniFetcher"
    }
  }
}
