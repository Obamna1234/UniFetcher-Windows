{
  "manifest_version": 3,
  "name": "UniFetcher Extension",
  "version": "1.4",
  "description": "Opens specified links in UniFetcher for download",
  "author": "UniFetcher (based on the Parabolic extension by NickvisionApps & OwlRoyalty)",
  "homepage_url": "https://github.com/Obamna1234/UniFetcher-Windows",
  "browser_specific_settings": {
  "gecko": {
    "id": "unifetcher-extension@obamna1234.github.io",
    "data_collection_permissions": {
      "required": ["none"]
    } 
  }
  },
  "permissions": [
    "activeTab",
    "contextMenus",
    "storage"
  ],
  "background": {
    "scripts": ["utils.js", "background.js"]
  },
  "options_page": "options.html",
  "action": {
    "default_icon": {
      "38": "icons/icon38.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "38": "icons/icon38.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "open-unifetcher-current-tab": {
      "suggested_key": {
        "default": "Alt+P",
        "mac": "Alt+P"
      },
      "description": "Opens current tab in UniFetcher."
    },
    "open-unifetcher-options": {
      "suggested_key": {
        "default": "Alt+O",
        "mac": "Alt+O"
      },
      "description": "Opens UniFetcher Options page."
    }
  }
}