<Project Sdk="Microsoft.NET.Sdk">

	<!-- Tiny helper the browser extension starts ("native messaging"). It passes links to the UniFetcher app on this PC. No internet. -->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
		<AssemblyName>UniFetcher.NativeHost</AssemblyName>
		<RootNamespace>UniFetcher.NativeHost</RootNamespace>
		<PublishAot>true</PublishAot>
		<InvariantGlobalization>true</InvariantGlobalization>
		<UseSystemResourceKeys>true</UseSystemResourceKeys>
		<Version>0.1.0</Version>
		<Product>UniFetcher</Product>
		<Company>UniFetcher</Company>
		<Description>Helper that lets the optional Send to UniFetcher browser extension pass links to UniFetcher</Description>
	</PropertyGroup>

</Project>
